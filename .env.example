# Copia estos nombres en Vercel → Settings → Environment Variables.
# (Nunca subas un archivo .env con valores reales a GitHub.)

# Panel de administración (/admin). Elige tú el usuario y una contraseña larga.
ADMIN_USUARIO=
ADMIN_PASSWORD=

# Vercel Blob: guarda fotos, catálogo y blog. Vercel → Storage → Create → Blob.
BLOB_READ_WRITE_TOKEN=

# Pagos en MXN (Mercado Pago → Tus integraciones → Credenciales)
MERCADOPAGO_ACCESS_TOKEN=

# Aviso por correo de cada pedido pagado (opcional) — resend.com → API Keys.
# Sin esta variable no se manda correo, pero los pedidos siempre aparecen en /admin/pedidos.
RESEND_API_KEY=
# AVISO_EMAIL=correo@donde-quieres-el-aviso.com   (por defecto, el correo de site-config)

# Pagos en USD (Stripe → Developers → API keys → Secret key)
STRIPE_SECRET_KEY=
# Firma de los avisos de Stripe: Developers → Webhooks → tu endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Dirección pública del sitio (para los regresos del pago y el sitemap)
NEXT_PUBLIC_SITE_URL=https://undisclosedvintage.com
